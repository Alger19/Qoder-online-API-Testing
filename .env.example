# 复制成 .env 后再改（.env 本身已被 .gitignore 排除，不会进仓库）
#
#   cp .env.example .env
#
# 令牌不在文件里配置 —— 打开页面后在输入框里填。

# ---------------------------------------------------------------------------
# 服务区域：由页面上的下拉框选择，这里不需要配。
#   中国站 https://api.qoder.com.cn  /  国际站 https://api.qoder.com
#
# 仅调试用：设置这一项会强制覆盖区域选择，指向任意上游。
# ---------------------------------------------------------------------------
# QODER_API_BASE_OVERRIDE=http://127.0.0.1:9911

# 本机监听端口
PORT=8787

# 单轮最长静默时间（毫秒）——超过这么久没有任何进展就放弃这一轮
TURN_TIMEOUT_MS=120000

# Agent 交付的文件自动保存到哪个目录（默认：项目下的 downloads/）
# DOWNLOAD_DIR=/Users/you/Downloads/qoder

# 上传与附件的大小上限
# MAX_UPLOAD_BYTES=20971520        # 单个上传文件 20 MB
# MAX_TEXT_ATTACHMENT_CHARS=200000 # 文本附件最多 20 万字符
